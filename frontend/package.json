{
  "name": "taskflow-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-jsx-runtime": "^9.4.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:watch": "react-scripts test",
    "test:integration": "react-scripts test --testPathPattern=integration --watchAll=false",
    "test:e2e": "playwright test",
    "test:a11y": "react-scripts test --testPathPattern=accessibility --watchAll=false",
    "test:security": "react-scripts test --testPathPattern=security --watchAll=false",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^@fluentui/react-jsx-runtime/jsx-runtime$": "<rootDir>/node_modules/@fluentui/react-jsx-runtime/lib-commonjs/jsx-runtime.cjs"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/user-event": "^14.6.7",
    "jest-axe": "^11.0.0"
  }
}
